{
  "name": "gg.glitchless.sdk",
  "version": "0.1.0",
  "displayName": "Glitchless",
  "description": "Game observability for Unity: frame times and stutter with their likely causes, errors and exceptions, scenes as levels, deaths and where players quit. Anonymous by default. An MCP server lets coding agents read the data and fix the game.",
  "unity": "2022.3",
  "dependencies": {
    "com.unity.modules.unitywebrequest": "1.0.0"
  },
  "documentationUrl": "https://github.com/glitchless-gg/glitchless/blob/main/unity/Packages/gg.glitchless.sdk/README.md",
  "changelogUrl": "https://github.com/glitchless-gg/glitchless/blob/main/unity/Packages/gg.glitchless.sdk/CHANGELOG.md",
  "licensesUrl": "https://github.com/glitchless-gg/glitchless/blob/main/unity/Packages/gg.glitchless.sdk/LICENSE.md",
  "license": "MIT",
  "keywords": [
    "observability",
    "performance",
    "frame-time",
    "stutter",
    "crash-reporting",
    "error-tracking",
    "analytics",
    "telemetry",
    "mcp"
  ],
  "author": {
    "name": "Glitchless",
    "url": "https://www.glitchless.gg"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glitchless-gg/glitchless.git"
  },
  "samples": [
    {
      "displayName": "Fetch! (sample game)",
      "description": "A small runner with an autoplay bot and four planted bugs for Glitchless to find.",
      "path": "Samples~/Fetch"
    }
  ]
}
