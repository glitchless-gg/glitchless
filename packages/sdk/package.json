{
  "name": "glitchless",
  "version": "0.5.0",
  "description": "Game observability SDK for web games (Three.js, Phaser 3 and 4, Babylon.js, PlayCanvas, or plain WebGL): frame time, stutter, errors and where players quit, with an in-game overlay and WebMCP tools for coding agents.",
  "keywords": [
    "game-observability",
    "observability",
    "gamedev",
    "game-development",
    "game-analytics",
    "threejs",
    "three.js",
    "phaser",
    "phaser3",
    "phaser4",
    "babylonjs",
    "babylon.js",
    "playcanvas",
    "webgl",
    "web-games",
    "performance",
    "frame-time",
    "fps",
    "stutter",
    "telemetry",
    "crash-reporting",
    "error-tracking",
    "webmcp",
    "mcp"
  ],
  "homepage": "https://www.glitchless.gg",
  "bugs": {
    "url": "https://github.com/glitchless-gg/glitchless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glitchless-gg/glitchless.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./three": "./src/three.js",
    "./phaser": "./src/phaser.js",
    "./babylon": "./src/babylon.js",
    "./playcanvas": "./src/playcanvas.js",
    "./sketch": "./src/sketch.js"
  },
  "files": [
    "src",
    "dist",
    "PRIVACY.md"
  ],
  "scripts": {
    "build": "esbuild src/global.js --bundle --minify --format=iife --sourcemap --outfile=dist/glitchless.js && esbuild src/index.js --bundle --minify --format=esm --outfile=dist/glitchless.esm.js",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@babylonjs/core": "~9.30.0",
    "esbuild": "^0.28.2",
    "playcanvas": "~2.23.2"
  }
}
