{
  "name": "glitchless-mcp",
  "version": "0.10.1",
  "mcpName": "io.github.glitchless-gg/glitchless",
  "description": "Game observability and analytics MCP server for Unity, Godot, Unreal, Three.js, Phaser and GameMaker games. Coding agents (Claude Code, Codex, Cursor and others) read your players' stutters, crashes, custom metrics and ranked findings, build the game's own dashboard, and run playtest bots.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "game-observability",
    "observability",
    "gamedev",
    "game-analytics",
    "dashboard",
    "game-development",
    "threejs",
    "godot",
    "unreal-engine",
    "performance",
    "playtesting",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "game-telemetry",
    "telemetry",
    "analytics",
    "game-debugging",
    "crash-reporting",
    "frame-time",
    "fps",
    "stutter",
    "unity",
    "phaser",
    "babylonjs",
    "playcanvas",
    "gamemaker",
    "indie-games"
  ],
  "homepage": "https://www.glitchless.gg",
  "bugs": {
    "url": "https://github.com/glitchless-gg/glitchless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glitchless-gg/glitchless.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "glitchless-mcp": "src/index.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "bundle": "esbuild src/index.js --bundle --platform=node --format=esm --target=node20 --external:playwright --outfile=../../plugin/glitchless/mcp/glitchless-mcp.mjs --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7",
    "glitchless-playtest": "^0.2.0",
    "glitchless-deck": "^0.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "esbuild": "^0.28.2"
  }
}
