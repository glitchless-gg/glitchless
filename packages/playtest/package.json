{
  "name": "glitchless-playtest",
  "version": "0.4.0",
  "description": "Playtest bots for game observability: your game's autoplay bot plays a Unity, Godot, Unreal or GameMaker build, a Roblox game in Roblox Studio, or a web game (Three.js, Phaser, Babylon.js, PlayCanvas) in Chrome, on the current code and on a saved baseline, and Glitchless flags what got slower or started breaking.",
  "keywords": [
    "playtesting",
    "playtest",
    "game-observability",
    "gamedev",
    "game-development",
    "bots",
    "automated-testing",
    "performance",
    "regression-testing",
    "playwright",
    "unity",
    "godot",
    "unreal-engine",
    "gamemaker",
    "roblox",
    "threejs",
    "phaser",
    "web-games",
    "mcp"
  ],
  "homepage": "https://www.glitchless.gg",
  "bugs": {
    "url": "https://github.com/glitchless-gg/glitchless/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glitchless-gg/glitchless.git",
    "directory": "packages/playtest"
  },
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "glitchless-playtest": "bin/glitchless-playtest.js"
  },
  "files": [
    "bin",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
