{
  "name": "glitchless-monorepo",
  "private": true,
  "type": "module",
  "description": "Glitchless — observability for vibe-coded games",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "server": "node server/src/local.js",
    "dashboard": "npm run dev -w glitchless-dashboard",
    "game": "npm run dev -w zoomies",
    "build": "npm run build -w glitchless && npm run build -w glitchless-dashboard && npm run build -w zoomies && npm run bundle -w glitchless-mcp",
    "seed": "node scripts/seed.js",
    "test": "npm test -w glitchless -w glitchless-server -w glitchless-playtest",
    "test:godot": "node godot/test/e2e.mjs",
    "test:otlp": "node server/test/otlp-collector.e2e.mjs",
    "bots": "node scripts/bots.js",
    "playtest": "node packages/playtest/bin/glitchless-playtest.js",
    "loadtest:lake": "node scripts/lake-loadtest.js",
    "webmcp:smoke": "node scripts/webmcp-smoke.js",
    "deploy:aws": "node server/web/deploy.js",
    "teardown:aws": "node server/web/teardown.js",
    "datadog:setup": "node datadog/setup.js",
    "mcp": "node packages/mcp/src/index.js"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
