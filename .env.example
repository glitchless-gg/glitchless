# Datadog — forwarding needs only an API key; datadog/setup.js (dashboard + monitors) also needs an app key
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# OpenTelemetry: OTLP/HTTP JSON to a Collector or any OTLP backend (README: Exporters)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=api-key=...
# OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative   # or delta

# Glitchless server
GLITCHLESS_CLIENT_TOKENS=gl_pub_dev        # public write tokens accepted by /v1/intake
GLITCHLESS_API_KEY=                        # optional read key for /v1/query (dashboard + MCP)
# PORT=7777                               # where the server listens
# GLITCHLESS_DATA_DIR=./data              # where the file store keeps events, maps, reports and dashboards
# GLITCHLESS_DATADOG=off                   # disable forwarding even when a key is present
# GLITCHLESS_ALERT_WEBHOOK=https://discord.com/api/webhooks/…   # alerts to Discord or Slack, checked every 15 min (npm run server)
# GLITCHLESS_ALERT_FORMAT=slack            # for a Slack-compatible webhook on another host

# image generation (assets/brand) — optional
FAL_KEY=
